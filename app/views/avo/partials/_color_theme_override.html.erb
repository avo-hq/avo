<script nonce="<%= content_security_policy_nonce %>">
  // Apply color scheme and theme classes before paint to avoid FOUC.
  // Database-persisted and locked settings are already server-rendered
  // on <html>. This script handles cookie overrides and "auto" dark mode.
  (function() {
    var root = document.documentElement;
    var appearance = window.Avo && window.Avo.configuration && window.Avo.configuration.appearance || {};

    // Restore the kbd-badge visibility preference (Shift+K) before paint so a
    // hidden set of badges never flashes in. It's a per-client preference, so it
    // lives in localStorage rather than a cookie; the class sits on <html> next
    // to the theme classes, which also lets it persist across Turbo navigations.
    var hotkeys = window.Avo && window.Avo.configuration && window.Avo.configuration.hotkeys || {};
    if (hotkeys.showKeyBadges !== false) {
      try {
        if (localStorage.getItem('avo:hotkeys:hide_badges') === '1') {
          root.classList.add('hotkeys-hide-badges');
        }
      } catch (e) {}
    }

    if (appearance.persistence !== 'database') {
      function getCookie(name) {
        var value = '; ' + document.cookie;
        var parts = value.split('; ' + name + '=');
        if (parts.length === 2) return parts.pop().split(';').shift();
        return null;
      }

      function removePrefixed(prefix) {
        Array.from(root.classList).forEach(function(cls) {
          if (cls.indexOf(prefix) === 0) root.classList.remove(cls);
        });
      }

      function setScheme(scheme) {
        root.classList.remove('scheme-light', 'scheme-dark', 'scheme-auto');
        root.classList.add('scheme-' + scheme);
        if (scheme === 'dark') {
          root.classList.add('dark');
        } else if (scheme === 'light') {
          root.classList.remove('dark');
        }
      }

      // The theme comes first: its locks decide whether the other cookies
      // apply at all, and a theme that owns a dimension forces it.
      var theme = appearance.theme || null;
      if (!appearance.themeLocked) {
        var pickedTheme = getCookie((Avo.configuration.cookies_key || 'avo') + '.theme');
        if (pickedTheme && (appearance.themes || []).indexOf(pickedTheme) !== -1) {
          theme = pickedTheme;
          removePrefixed('avo-theme-');
          root.classList.add('avo-theme-' + theme);
        }
      }
      var locks = (theme && appearance.themeLocks && appearance.themeLocks[theme]) || [];

      if (locks.indexOf('neutral') !== -1) {
        removePrefixed('neutral-theme-');
      } else if (!appearance.neutralLocked) {
        var neutral = getCookie('theme');
        if (neutral && neutral !== 'brand') {
          removePrefixed('neutral-theme-');
          root.classList.add('neutral-theme-' + neutral);
        }
      }

      if (locks.indexOf('accent') !== -1) {
        removePrefixed('accent-theme-');
      } else if (!appearance.accentLocked) {
        var accent = getCookie('accent_color');
        if (accent && accent !== 'brand') {
          removePrefixed('accent-theme-');
          root.classList.add('accent-theme-' + accent);
        }
      }

      if (locks.indexOf('scheme') !== -1) {
        setScheme((appearance.themeSchemes && appearance.themeSchemes[theme]) || 'light');
      } else if (!appearance.schemeLocked) {
        var scheme = getCookie('color_scheme');
        if (scheme) setScheme(scheme);
      }
    }

    // Handle "auto" scheme — always needs JS for media query detection
    if (root.classList.contains('scheme-auto')) {
      if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
        root.classList.add('dark');
      } else {
        root.classList.remove('dark');
      }
    }
  })();
</script>
