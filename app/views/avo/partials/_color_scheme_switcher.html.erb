<% appearance = Avo.configuration.appearance %>
<% theme = current_theme %>
<% show_theme_picker = !appearance.theme_locked? && Avo.theme_manager.offered.size > 1 %>
<%# The host's locks decide whether a picker exists at all. The active theme's
    locks only hide it (the `hidden` attribute, toggled by the appearance
    controller), because picking another theme can bring it back without a
    reload. %>
<% show_neutral_picker = !appearance.neutral_locked? %>
<% show_accent_picker = !appearance.accent_locked? %>
<% show_scheme_picker = !appearance.scheme_locked? %>
<% theme_hides = {neutral: theme&.locks?(:neutral) || false, accent: theme&.locks?(:accent) || false, scheme: theme&.locks?(:scheme) || false} %>
<% show_key_badges_toggle = Avo.configuration.hotkeys[:enabled] && Avo.configuration.hotkeys[:show_key_badges] %>
<% return unless show_theme_picker || show_neutral_picker || show_accent_picker || show_scheme_picker || show_key_badges_toggle %>
<% locals = {
     appearance: appearance,
     show_theme_picker: show_theme_picker,
     offered_themes: Avo.theme_manager.offered,
     active_theme: theme,
     show_neutral_picker: show_neutral_picker,
     show_accent_picker: show_accent_picker,
     show_scheme_picker: show_scheme_picker,
     theme_hides: theme_hides,
     show_key_badges_toggle: show_key_badges_toggle,
     active_neutral: current_neutral,
     active_accent: current_accent,
     neutral_labels: appearance_neutral_labels(appearance.neutrals)
   } %>

<%# :inline renders BOTH the desktop pill (lg:+) and the compact dropdown trigger (mobile fallback). %>
<%# :dropdown renders ONLY the compact dropdown trigger at every breakpoint. %>
<% if appearance.picker_layout == :inline %>
  <%= render partial: "avo/partials/switcher_inline", locals: locals %>
<% end %>
<%= render partial: "avo/partials/switcher_dropdown", locals: locals %>
