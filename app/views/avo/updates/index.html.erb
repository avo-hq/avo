<% content_for :page_title, "Updates" %>
<%= render ui.panel(title: "Updates", description: "Release notes for Avo and your Avo gems, newest first.") do |panel| %>
  <% panel.with_controls do %>
    <%= a_link avo.status_path, style: :outline, color: :gray, size: :sm, icon: "tabler/outline/arrow-left" do %>
      Status
    <% end %>
  <% end %>
  <% panel.with_body do %>
    <% if @releases.empty? %>
      <%= render ui.card(padded: true) do |card| %>
        <% card.with_body do %>
          <p class="updates-page__empty">No release notes to show. avohq.io may be unreachable, so try again in a bit.</p>
        <% end %>
      <% end %>
    <% else %>
      <ol class="updates-page">
        <% @releases.each do |release| %>
          <% installed = installed?(release) %>
          <li>
            <%= render ui.card(padded: true) do |card| %>
              <% card.with_body do %>
                <article class="updates-page__release">
                  <header class="updates-page__header">
                    <h3 class="updates-page__title">
                      <%= link_to "#{release["gem"]} #{release["version"]}", release["url"], target: "_blank", rel: "noopener" %>
                    </h3>
                    <% if installed %>
                      <%= render ui.badge(label: "Installed", color: :success) %>
                    <% else %>
                      <%= render ui.badge(label: "Available", color: :warning) %>
                    <% end %>
                    <% if release["released_at"].present? %>
                      <time class="updates-page__date" datetime="<%= release["released_at"] %>"><%= Time.zone.parse(release["released_at"]).to_date.to_fs(:long) %></time>
                    <% end %>
                  </header>
                  <% if release["name"].present? && release["name"].exclude?(release["version"]) %>
                    <p class="updates-page__name"><%= release["name"] %></p>
                  <% end %>
                  <%# The hand-written announcement first, then the GitHub notes, as on the release's own page. %>
                  <% %w[body description].each do |notes| %>
                    <% if release["#{notes}_html"].present? || release[notes].present? %>
                      <div class="updates-page__body">
                        <%= sanitize(release["#{notes}_html"].presence || simple_format(release[notes])) %>
                      </div>
                    <% end %>
                  <% end %>
                </article>
              <% end %>
            <% end %>
          </li>
        <% end %>
      </ol>
    <% end %>
    <% if @page > 1 || @next_page %>
      <nav class="updates-page__pagination" aria-label="Release notes pages">
        <% if @page > 1 %>
          <%= a_link avo.updates_path(page: @page - 1), style: :outline, color: :gray, size: :sm, icon: "tabler/outline/arrow-left" do %>
            Newer
          <% end %>
        <% end %>
        <% if @next_page %>
          <%= a_link avo.updates_path(page: @next_page), style: :outline, color: :gray, size: :sm, end_icon: "tabler/outline/arrow-right" do %>
            Older
          <% end %>
        <% end %>
      </nav>
    <% end %>
  <% end %>
<% end %>
