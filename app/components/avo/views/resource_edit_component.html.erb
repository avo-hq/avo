<%= content_tag :div,
  id: helpers.frame_id(@resource),
  data: {
    model_name: @resource.model_name.to_s,
    resource_name: @resource.class.to_s,
    record_id: @resource.record_param,
    selected_resources_name: @resource.model_key,
    selected_resources: [@resource.record_param],
    **@resource.stimulus_data_attributes
  } do %>
  <%= render_resource_slot :before_cards %>
  <%= render_resource_slot(:cards) { render_cards_component } %>
  <%= render_resource_slot :after_cards %>

  <%= render_resource_slot :before_form %>

  <%= build_form do |form| %>
    <% @form = form %>
    <%= render Avo::ReferrerParamsComponent.new back_path: back_path %>

    <%= render_resource_slot :form do %>
      <% if embedded_in_modal? %>
        <%# The form wraps the modal so the footer submit button posts natively. %>
        <%= render Avo::ModalComponent.new(width: :"4xl", body_class: "modal-form-body") do |c| %>
          <% c.with_heading do %>
            <%= render_resource_slot :before_title %>
            <%= render_resource_slot(:title) { title } %>
            <%= render_resource_slot :after_title %>
          <% end %>

          <% c.with_controls do %>
            <%= render_resource_slot :before_controls %>

            <%= render_resource_slot :controls do %>
              <% @resource.render_edit_controls.each do |control| %>
                <%= render_control control %>
              <% end %>
            <% end %>

            <%= render_resource_slot :after_controls %>
          <% end %>

          <%= content_tag :div, class: "panel-spacer" do %>
            <%= render_resource_slot :before_body %>
            <%= render_resource_slot(:body) { render_form_items(form) } %>
            <%= render_resource_slot :after_body %>
          <% end %>
        <% end %>
      <% else %>
        <%= content_tag :div, class: "panel-spacer" do %>
          <%= render_resource_slot :before_body %>
          <%= render_resource_slot(:body) { render_form_items(form) } %>
          <%= render_resource_slot :after_body %>

          <% if Avo.configuration.buttons_on_form_footers %>
            <%= render ui.panel do |panel| %>
              <% panel.with_footer do %>
                <%= render ui.panel_header do |header| %>
                  <% header.with_controls do %>
                    <%= render_resource_slot :before_controls %>

                    <%= render_resource_slot :controls do %>
                      <% @resource.render_edit_controls.each do |control| %>
                        <%= render_control control %>
                      <% end %>
                    <% end %>

                    <%= render_resource_slot :after_controls %>
                  <% end %>
                <% end %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <% @form = nil %>
  <% end %>

  <%= render_resource_slot :after_form %>
<% end %>
