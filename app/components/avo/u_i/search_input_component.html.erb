<%= content_tag :div, class: "search-input" do %>
  <%= search_field_tag @name, @value,
    id: @id,
    placeholder: @placeholder,
    class: class_names(
      @classes,
      "search-input__input",
      "search-input__input--with-shortcut": @shortcut == :slash,
      "search-input__input--with-two-key-shortcut": @shortcut == :cmd_k
    ),
    disabled: @disabled,
    autocomplete: "off",
    data: @data
  %>

  <span class="search-input__prefix" aria-hidden="true">
    <%= helpers.svg "tabler/outline/search" %>
  </span>

  <% if shortcut_hotkey %>
    <%= hotkey_badge(shortcut_hotkey, class: "search-input__suffix", aria: {hidden: true}) %>
  <% end %>
<% end %>
