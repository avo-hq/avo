<%= field_wrapper(**field_wrapper_args) do %>
  <%# The blank option keeps a record without a value from saving the first option. %>
  <%= @form.select @field.id, options, {include_blank: true},
    class: classes("w-full"),
    data: @field.get_html(:data, view: view, element: :input),
    disabled: disabled?,
    style: @field.get_html(:style, view: view, element: :input),
    autofocus: @autofocus
  %>
<% end %>
