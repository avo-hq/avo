<%= index_field_wrapper(**field_wrapper_args) do %>
  <%# The date-field controller replaces this div's innerText, so the record link has to wrap it. %>
  <%= link_to_if @field.link_to_record, tag.div(@field.formatted_value, class: "inline-block", data: {
    controller: "date-field",
    date_field_view_value: @view,
    date_field_format_value: @field.format,
    date_field_field_type_value: "date",
  }), resource_view_path %>
<% end %>
