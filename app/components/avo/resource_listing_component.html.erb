<%= content_tag :div, id: resource_body_content_id(@resource) do %>
  <%= render Avo::SearchOverlayComponent.new %>

  <% if @resources.present? %>
    <div class="relative mt-0 flex w-full flex-1">
      <%= render(@resource.resolve_component(specific_view_component).new(
        resources: @resources,
        resource: @resource,
        reflection: @reflection,
        parent_record: @parent_record,
        parent_resource: @parent_resource,
        pagy: @pagy,
        query: @query,
        actions: @actions,
        turbo_frame: @turbo_frame,
        index_params: @index_params
      )) %>
    </div>
  <% else %>
    <%= render_index_slot :before_collection %>
    <%= render_index_slot :collection do %>
      <%= render_index_slot :before_records %>
      <%= render_index_slot(:records) { helpers.empty_state by_association: params[:related_name].present? } %>
      <%= render_index_slot :after_records %>
    <% end %>
    <%= render_index_slot :after_collection %>
  <% end %>
<% end %>
