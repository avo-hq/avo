<%= tag.div class: "tenant-switcher" do %>
  <%= render Avo::UI::DropdownComponent.new(popover_mode: true, searchable: searchable?, classes: "sidebar-profile__dropdown tenant-switcher__panel") do |dropdown| %>
    <% dropdown.with_trigger do %>
      <button type="button"
        class="tenant-switcher__trigger"
        popovertarget="<%= dropdown.popover_id %>"
        aria-label="<%= t("avo.tenancy.switch_label", title: title_for(@current)) %>">
        <%= avatar_for(@current, size: "sm") %>
        <span class="tenant-switcher__text">
          <span class="tenant-switcher__title"><%= title_for(@current) %></span>
          <% if subtitle? %>
            <span class="sidebar-profile__subtitle truncate"><%= subtitle %></span>
          <% end %>
        </span>
        <%= helpers.svg "tabler/outline/selector", class: "tenant-switcher__chevron" %>
      </button>
    <% end %>
    <% dropdown.with_items do %>
      <% @tenants.each do |tenant| %>
        <%# A full page load: a Turbo visit would keep snapshots of the old account's pages in its cache. %>
        <%= button_to helpers.avo.switch_tenant_path,
          method: :patch,
          params: switch_params(tenant),
          form_class: "tenant-switcher__form",
          form: {data: {turbo: false}},
          class: item_classes(tenant),
          data: {filter_text: title_for(tenant)},
          aria: {current: current?(tenant) ? "true" : nil} do %>
          <%= avatar_for(tenant, size: "xs") %>
          <span class="tenant-switcher__name"><%= title_for(tenant) %></span>
          <span class="tenant-switcher__check-slot">
            <%= helpers.svg("tabler/outline/check", class: "tenant-switcher__check") if current?(tenant) %>
          </span>
        <% end %>
      <% end %>
    <% end %>
    <%# The footer sits outside the search's filter scope and the scrolling list, so sign out is always reachable. %>
    <% if menu? %>
      <% dropdown.with_footer { menu.to_s } %>
    <% end %>
  <% end %>
  <%= status_alert %>
<% end %>
