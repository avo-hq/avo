<% merged = ->(switcher) {
  switcher.with_subtitle { "Avo Cado" }
  switcher.with_menu { link_to("Sign out", "#") }
} %>
<div class="flex flex-wrap gap-8 p-6">
  <div class="flex flex-col gap-2">
    <p class="text-sm text-content-secondary">Three accounts</p>
    <div class="flex items-center gap-3">
      <%= render Avo::TenantSwitcherComponent.new(tenants:, current: tenants.first), &merged %>
    </div>
  </div>

  <div class="flex flex-col gap-2">
    <p class="text-sm text-content-secondary">Long current title (truncated)</p>
    <div class="flex items-center gap-3">
      <%= render Avo::TenantSwitcherComponent.new(tenants:, current: tenants.last), &merged %>
    </div>
  </div>

  <div class="flex flex-col gap-2">
    <p class="text-sm text-content-secondary">Many accounts (filterable list)</p>
    <div class="flex items-center gap-3">
      <%= render Avo::TenantSwitcherComponent.new(tenants: many, current: many[4]), &merged %>
    </div>
  </div>

  <div class="flex flex-col gap-2">
    <p class="text-sm text-content-secondary">One account (renders nothing; the sidebar keeps the plain profile row)</p>
    <div class="flex items-center gap-3">
      <%= render Avo::TenantSwitcherComponent.new(tenants: tenants.first(1), current: tenants.first) %>
    </div>
  </div>
</div>
