#!/usr/bin/env bash
# Prepares a fresh Amp orb for Avo development: installs system packages,
# Postgres, Ruby via mise, gems, and Yarn packages (the last three in parallel
# with the system packages), then hands off to bin/setup --fast for databases
# and assets.
# Idempotent: a warm run (stale snapshot) only re-checks and refreshes.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

step() {
  local label="$1"
  shift
  echo "==> $label"
  local started=$SECONDS
  "$@"
  echo "    ($label took $((SECONDS - started))s)"
}

export DEBIAN_FRONTEND=noninteractive
export AVO_LICENSE_KEY="${AVO_LICENSE_KEY:-license_123}"

apt_updated=false
install_packages() {
  local missing=()
  for pkg in "$@"; do
    dpkg -s "$pkg" >/dev/null 2>&1 || missing+=("$pkg")
  done
  if ((${#missing[@]})); then
    $apt_updated || sudo apt-get update -qq
    apt_updated=true
    sudo apt-get install -y -qq --no-install-recommends "${missing[@]}"
  else
    echo "    all packages present: $*"
  fi
}

# Needed to compile native gem extensions. The base image already has them, so
# this is usually a no-op; it runs before gems install so they never race.
install_build_packages() {
  install_packages build-essential libyaml-dev libpq-dev
}

# Needed only at runtime, so these install while gems and Yarn packages do.
install_runtime_packages() {
  install_packages postgresql libvips42 lsof
}

start_postgres() {
  local conf_dir
  conf_dir="$(ls -d /etc/postgresql/*/main | sort -V | tail -1)"

  # Trust local connections as user `postgres` with no password, matching
  # spec/dummy/config/database.yml defaults.
  if ! sudo grep -q "^# avo-orb-trust" "$conf_dir/pg_hba.conf"; then
    sudo tee "$conf_dir/pg_hba.conf" >/dev/null <<'EOF'
# avo-orb-trust: development-only orb configuration
local   all all                trust
host    all all 127.0.0.1/32   trust
host    all all ::1/128        trust
EOF
  fi

  # Ephemeral sandbox: prefer speed over durability.
  sudo tee "$conf_dir/conf.d/avo-orb.conf" >/dev/null <<'EOF'
fsync = off
synchronous_commit = off
full_page_writes = off
EOF

  sudo systemctl enable --quiet postgresql
  sudo systemctl restart postgresql
  for _ in $(seq 1 30); do
    pg_isready -q -h localhost -U postgres && return 0
    sleep 1
  done
  echo "Postgres did not become ready" >&2
  return 1
}

install_ruby() {
  if [[ ! -x "$HOME/.local/bin/mise" ]]; then
    curl -fsSL https://mise.run | MISE_QUIET=1 sh
  fi
  mise trust --quiet "$repo_root/mise.toml"
  # mise.toml pins only `ruby = "4"`. Without this, a Ruby release that has no
  # prebuilt binary yet makes mise compile it from source, which takes minutes;
  # with it, mise picks the newest 4.x that has a prebuilt binary.
  MISE_RUBY_COMPILE=false mise install --yes
}

# Most of a cold setup: about 20 gems compile native extensions.
install_ruby_and_gems() {
  install_ruby
  bundle config set --local jobs "$(nproc)" >/dev/null
  bundle install --quiet
}

install_yarn_packages() {
  yarn install --silent
}

# Runs a step in the background and keeps its output out of the foreground
# log until wait_background prints it.
bg_pids=()
bg_logs=()
background() {
  local log
  log="$(mktemp)"
  step "$@" >"$log" 2>&1 &
  bg_pids+=("$!")
  bg_logs+=("$log")
}

wait_background() {
  local failed=0 i
  for i in "${!bg_pids[@]}"; do
    wait "${bg_pids[$i]}" || failed=1
    cat "${bg_logs[$i]}"
    rm -f "${bg_logs[$i]}"
  done
  return "$failed"
}

persist_shell_env() {
  local marker="# avo: mise shims and dev defaults"
  if ! grep -Fqx "$marker" "$HOME/.bash_profile" 2>/dev/null; then
    cat >>"$HOME/.bash_profile" <<EOF

$marker
case ":\$PATH:" in
  *":\$HOME/.local/share/mise/shims:"*) ;;
  *) export PATH="\$HOME/.local/bin:\$HOME/.local/share/mise/shims:\$PATH" ;;
esac
export AVO_LICENSE_KEY="\${AVO_LICENSE_KEY:-license_123}"
EOF
  fi
}

# .env.test, fast-seeded dev DB, test schema, and assets. Its bundle install
# and yarn steps only re-check what the background steps installed.
run_bin_setup() {
  bin/setup --fast
}

write_agent_guidance() {
  mkdir -p "$HOME/.config/amp"
  local guidance="$HOME/.config/amp/AGENTS.md"
  local marker="# Avo orb notes"
  if ! grep -Fqx "$marker" "$guidance" 2>/dev/null; then
    cat >>"$guidance" <<'EOF'

# Avo orb notes

- `.agents/setup` already installed Ruby (mise), gems, Yarn packages, Postgres (systemd), the dev/test databases, and built assets.
- `AVO_LICENSE_KEY=license_123` is exported in login shells; Postgres trusts `postgres` on localhost.
- Run the app with `amp orb services ensure` (see `.amp/services.yaml`), not `bin/dev`. Log in at `/users/sign_in` with `hi@avohq.io` / `secreto`.
- Rebuild assets with `yarn build:js`, `yarn build:custom-js`, `yarn build:css` when not running the watcher services.
EOF
  fi
}

export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$PATH"

step "Build packages" install_build_packages
# Ruby, gems, and Yarn packages don't need the runtime packages or Postgres,
# so they install at the same time.
background "Ruby and gems" install_ruby_and_gems
background "Yarn packages" install_yarn_packages
step "Runtime packages" install_runtime_packages
step "Postgres" start_postgres
step "Shell environment" persist_shell_env
wait_background
step "bin/setup --fast" run_bin_setup
step "Agent guidance" write_agent_guidance

echo "==> Avo orb setup complete"
